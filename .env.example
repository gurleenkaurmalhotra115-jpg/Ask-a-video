GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated fallback model chain (tried in order on transient failures).
# Example: gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=
# Backward-compatible single fallback model variable (used if GEMINI_FALLBACK_MODELS is empty)
GEMINI_FALLBACK_MODEL=
# Minimum top-1 cosine similarity required before invoking the LLM (0.0 disables the gate)
MIN_RETRIEVAL_CONFIDENCE=0.22
